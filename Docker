FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-deps flatlib==0.2.3 && \
    pip install fastapi==0.111.0 uvicorn[standard]==0.29.0 pysweph==2.10.3.6 pydantic==2.11.4 timezonefinder==6.5.2 python-dateutil==2.9.0

COPY . .

EXPOSE 10000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000"]
